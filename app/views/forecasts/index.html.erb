<div class="mb-10 max-w-2xl">
  <p class="mb-3 text-xs font-semibold tracking-widest text-emerald-700 uppercase">A look at the day ahead</p>
  <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">Weather, at your address.</h1>
  <p class="mt-4 text-base leading-7 text-slate-600">Current temperature and today's high and low. Just enter a US address.</p>
</div>

<div class="grid items-start gap-6 lg:grid-cols-5">
  <section aria-labelledby="search-heading" class="rounded-2xl border border-stone-200 bg-white p-6 sm:p-8 lg:col-span-2">
    <h2 id="search-heading" class="text-xl font-semibold">Find your forecast</h2>
    <p id="address-help" class="mt-2 text-sm leading-6 text-slate-500">Include the house number, street, city and state.</p>

    <%= form_with url: forecast_path, method: :post, local: true, data: { turbo: false }, class: "mt-6" do |form| %>
      <%= form.label :address, "US address", class: "mb-2 block text-sm font-medium" %>
      <%= form.text_field :address,
        value: @address,
        required: true,
        placeholder: "350 5th Avenue, New York, NY",
        aria: { describedby: @error ? "address-help search-error" : "address-help", invalid: @error.present? },
        class: "w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-base outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/20" %>

      <% if @error %>
        <p id="search-error" role="alert" class="mt-3 rounded-lg bg-red-50 p-3 text-sm leading-6 text-red-800"><%= @error %></p>
      <% end %>

      <%= form.submit "Get forecast", class: "mt-4 w-full cursor-pointer rounded-lg bg-emerald-800 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700" %>
    <% end %>

    <p class="mt-5 text-xs leading-6 text-slate-500">Forecasts are saved for 30 minutes per ZIP code. Repeat searches can use the saved forecast.</p>
  </section>

  <section aria-labelledby="forecast-heading" class="overflow-hidden rounded-2xl border border-stone-200 bg-white lg:col-span-3">
    <% if @forecast %>
      <div class="p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="forecast-heading" class="text-xl font-semibold">Current weather</h2>
          <span id="cache-status" class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800">
            <%= @cached ? "From cache" : "Fresh forecast" %>
          </span>
        </div>
        <p class="mt-5 text-sm font-semibold text-slate-700">ZIP <%= @location[:postal_code] %> · <%= @location[:country] %></p>
        <p id="forecast-location" class="mt-2 text-sm leading-6 text-slate-500"><%= @location[:address] %></p>

        <p id="current-temperature" class="my-8 text-7xl font-semibold tracking-tighter sm:text-8xl">
          <%= number_with_precision(@forecast[:temperature], precision: 1, strip_insignificant_zeros: true) %><span class="ml-1 align-top text-3xl font-normal leading-relaxed tracking-normal text-slate-400">°<%= @forecast[:unit] %></span>
        </p>

        <dl class="grid grid-cols-2 gap-4 border-t border-stone-100 pt-6">
          <div>
            <dt class="text-sm text-slate-500">Today's high</dt>
            <dd id="high-temperature" class="mt-2 text-2xl font-semibold"><%= number_with_precision(@forecast[:high], precision: 1, strip_insignificant_zeros: true) %> °<%= @forecast[:unit] %></dd>
          </div>
          <div>
            <dt class="text-sm text-slate-500">Today's low</dt>
            <dd id="low-temperature" class="mt-2 text-2xl font-semibold"><%= number_with_precision(@forecast[:low], precision: 1, strip_insignificant_zeros: true) %> °<%= @forecast[:unit] %></dd>
          </div>
        </dl>
      </div>
      <p class="border-t border-stone-100 bg-stone-50 px-6 py-4 text-xs leading-6 text-slate-500 sm:px-8">
        Weather data updated
        <%= tag.time Time.at(@forecast[:updated_at]).utc.strftime("%b %-d, %Y · %H:%M UTC"), datetime: Time.at(@forecast[:updated_at]).utc.iso8601 %>.
      </p>
    <% else %>
      <div class="flex min-h-80 flex-col items-center justify-center p-8 text-center sm:min-h-96">
        <div aria-hidden="true" class="mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-amber-50 text-amber-500">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-9 w-9">
            <circle cx="12" cy="12" r="4" />
            <path stroke-linecap="round" d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5" />
          </svg>
        </div>
        <h2 id="forecast-heading" class="text-xl font-semibold"><%= @error ? "No forecast to show yet" : "Your forecast will appear here" %></h2>
        <p class="mt-3 max-w-xs text-sm leading-6 text-slate-500"><%= @error ? "Check the message next to the address field and try again." : "Search an address to see the current temperature and today's outlook." %></p>
      </div>
    <% end %>
  </section>
</div>
